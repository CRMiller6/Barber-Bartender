  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &93469538
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 93469537}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e36a870d2757d1145a04fb9536d0beb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueLines:
  - name: 
    text: 'Wait, What are YOU doing here?! I''m trying to teach my kid how to run
      a proper bar, and you just come barging in? '
    uncleSpeaking: 0
    dadSpeaking: 1
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 1
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: You really need to loosen up, man, I'm here to teach her too.
    uncleSpeaking: 1
    dadSpeaking: 0
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: She's going to learn how to cut hair to make people look really cool.
    uncleSpeaking: 1
    dadSpeaking: 0
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: She's my daughter, and I want to teach her to bartend.
    uncleSpeaking: 0
    dadSpeaking: 1
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: Well, she's my neice, and she inherited my half of this building too, I'll
      teach her how to cut hair, then she can choose which to do for herself.
    uncleSpeaking: 1
    dadSpeaking: 0
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: I'm not done teaching her, we haven't even gotten to yellow, come back
      in two years and maybe I'll let you teach her too.
    uncleSpeaking: 0
    dadSpeaking: 1
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
    text: While you were teaching her, I learned more ghost powers, so I don't think
      you have a say in this, goodbye.
    uncleSpeaking: 1
    dadSpeaking: 0
    removeButtonsOnStart: 0
    hasRemovedButtons: 0
    SpawnRed: 0
    hasSpawnedRed: 0
    SpawnDad: 0
    hasSpawnedDad: 0
    SpawnSubmit: 0
    hasSpawnedSubmit: 0
    waterTrigger: 0
    purpleTrigger: 0
    MoveCamera: 0
    hasMovedCamera: 0
  - name: 
